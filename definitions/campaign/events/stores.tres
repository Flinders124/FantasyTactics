[gd_resource type="Resource" script_class="CampaignEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/campaign_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
stable_id = "stores"
revision = 1
display_name = "The Quartermaster’s Ledger"
description = "The stores contain a handful of unclaimed fittings. Decide whether to trade them or keep a written account of their makers."
eligibility = "any"
choices = Array[Dictionary]([{ "id": "trade", "label": "Trade the spare fittings", "supplies": 3, "recovery": 0 },
{ "id": "record", "label": "Record their makers", "supplies": 0, "recovery": 0 }])
