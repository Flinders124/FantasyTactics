[gd_resource type="Resource" script_class="CampaignEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/campaign_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
stable_id = "salvage"
revision = 1
display_name = "The Broken Waycart"
description = "A companion brings back a damaged waycart. The Watch can salvage its fittings or leave them for the next travellers."
