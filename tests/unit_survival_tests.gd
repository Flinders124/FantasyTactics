extends SceneTree
var failures := 0
func check(value: bool, message: String) -> void:
	if not value: failures += 1; push_error(message)
func _initialize() -> void: call_deferred("run")
func make_unit(survival: bool = true) -> CombatUnit:
	var unit := load("res://scenes/combat_unit.tscn").instantiate() as CombatUnit
	unit.definition = HeroCatalog.find("recruit")
	unit.survival_enabled = survival
	root.add_child(unit)
	return unit
func down(unit: CombatUnit, round_number: int = 2) -> void:
	unit.downed_round = round_number
	unit.damage(99)
func run() -> void:
	var unit := make_unit()
	unit.begin_turn()
	unit.apply_ward(3)
	unit.end_turn()
	check(unit.ward_remaining == 3 and unit.ward_future_turns == 2, "Ward skips application turn")
	unit.begin_turn()
	unit.end_turn()
	check(unit.ward_remaining == 3 and unit.ward_future_turns == 1, "Ward survives first future turn")
	unit.begin_turn()
	unit.end_turn()
	check(unit.ward_remaining == 0, "Ward expires after second future target turn")
	unit.apply_ward(3)
	check(unit.damage(2) == 0 and unit.ward_remaining == 1 and unit.health == 20, "Ward consumes exact incoming damage")
	unit.apply_ward(4)
	check(unit.ward_remaining == 4, "Ward refresh replaces rather than stacks")
	check(unit.damage(6) == 2 and unit.health == 18 and unit.ward_remaining == 0, "Damage spills beyond finite ward")
	check((load("res://definitions/aegis_ward.tres") as StatusEffectDefinition).damage_absorption == 3, "Ward source resource immutable")
	unit.reset_for_encounter()
	down(unit)
	check(unit.life_state == CombatUnit.LifeState.DOWNED and not unit.is_alive() and unit.is_surviving(), "Lethal campaign hero damage incapacitates")
	check(unit.collision_layer == 4 and not unit.action_available and unit.movement_remaining == 0, "Downed units are pickable but cannot block or act")
	unit.begin_turn()
	check(not unit.action_available and unit.movement_remaining == 0, "Downed begin turn grants no resources")
	unit.on_round_end(2)
	check(unit.bleed_remaining == 3, "Bleed skips incapacitation round")
	unit.on_round_end(3)
	unit.on_round_end(3)
	check(unit.bleed_remaining == 2, "Only one bleed check per future round")
	unit.on_round_end(4)
	check(unit.bleed_remaining == 1 and unit.is_surviving(), "Second future check remains rescuable")
	unit.on_round_end(5)
	check(unit.life_state == CombatUnit.LifeState.DEAD and unit.survival_outcome == "dead", "Third future check kills")
	check(unit.heal(5) == 0 and not unit.is_surviving(), "Dead units never heal")
	unit.reset_for_encounter()
	down(unit)
	check(unit.stabilise(), "Downed unit stabilises")
	unit.on_round_end(99)
	check(unit.bleed_remaining == 3 and unit.is_downed(), "Stabilised unit stops bleeding")
	check(unit.heal(4) == 4 and unit.is_alive() and unit.collision_layer == 5, "Healing restores conscious collision")
	check(not unit.action_available and unit.movement_remaining == 0, "Revival never grants immediate extra actions")
	var carrier := make_unit()
	carrier.begin_turn()
	down(unit)
	check(carrier.pickup(unit), "Living hero can carry a downed ally")
	check(unit.carried_by == carrier and unit.collision_layer == 0 and not unit.visible, "Carried body leaves picking and world collision")
	check(carrier.movement_remaining <= 3.0, "Pickup caps current movement at half allowance")
	carrier.begin_turn()
	check(carrier.movement_granted == 3.0, "Carry halves future movement")
	carrier.global_position = Vector3(2, 0, 3)
	check(carrier.drop_carried() == unit and unit.carried_by == null and unit.visible and unit.collision_layer == 4, "Drop restores body picking")
	check(unit.global_position == carrier.global_position, "Drop places body at safe carrier position")
	check(carrier.pickup(unit), "Dropped companion can be picked up again")
	down(carrier)
	check(carrier.carried_unit == null and unit.carried_by == null and unit.visible, "Carrier incapacitation drops companion")
	carrier.reset_for_encounter()
	carrier.pickup(unit)
	carrier.set_extracted()
	check(carrier.life_state == CombatUnit.LifeState.EXTRACTED and unit.life_state == CombatUnit.LifeState.EXTRACTED, "Extraction includes carried companion")
	check(carrier.finalize_survival(false) == "extracted" and unit.finalize_survival(false) == "extracted", "Failure preserves extracted heroes")
	carrier.reset_for_encounter()
	check(carrier.is_alive() and carrier.carried_unit == null and carrier.visible and carrier.ward_remaining == 0 and carrier.survival_outcome.is_empty(), "Reset clears survival runtime")
	check(carrier.finalize_survival(true) == "recovered", "Victory recovers conscious hero")
	unit.reset_for_encounter()
	down(unit)
	unit.stabilise()
	check(unit.finalize_survival(true) == "recovered", "Victory recovers stabilised hero")
	unit.reset_for_encounter()
	down(unit)
	check(unit.finalize_survival(true) == "dead", "Victory loses unrescued bleeding hero")
	var legacy := make_unit(false)
	legacy.damage(99)
	check(legacy.death_handled and not legacy.is_surviving(), "Standalone retains immediate death")
	var enemy := make_unit()
	enemy.faction = CombatUnit.Faction.ENEMY
	enemy.damage(99)
	check(not enemy.is_surviving(), "Enemies retain immediate death")
	print("UNIT SURVIVAL RESULT: %d failures" % failures)
	quit(1 if failures else 0)
