class_name FieldGuide
extends RefCounted
static func camp_controls() -> String:
	return "CAMP HEADQUARTERS\nSelect a labelled location or its scenery with %s. Mission Board: deployment; Companions’ Tents: roster and recovery; Training Yard: upgrades; Armoury Tent: equipment; Commander’s Table: history.\nTab selects buttons; Enter activates. The bottom destination buttons offer the same menus. Back to Camp or %s closes a page. PgUp/PgDn cycles pages.\nDrag %s to orbit, %s / %s to zoom, and Reset view to restore the overview. Camera controls stop while a page, help or settings is open.\n\nTACTICAL CONTROLS\n"%[ControlBindings.label("world"),ControlBindings.label("cancel"),ControlBindings.label("orbit"),ControlBindings.label("zoom_in"),ControlBindings.label("zoom_out")]
static func objective(definition: ObjectiveDefinition) -> String:
	match definition.kind:
		ObjectiveDefinition.Kind.HOLD_GROUND:
			return "Hold Ground: have at least one conscious hero inside the marked circle and no living enemies inside. Checked once at the END OF EACH ROUND, after all living units have acted. Empty or contested checks reset progress. Win after %d consecutive controlled checks. Defeating every enemy does not win this objective. Losing all heroes is defeat." % definition.required_rounds
		ObjectiveDefinition.Kind.EXTRACTION:
			return "Extraction: both originally selected heroes must survive and reach the exit circle after a completed action. A carried companion counts at the carrier position. Neither hero leaves combat when inside. If either hero dies, you lose after the action finishes. Defeating all enemies does not complete extraction. Reaching the exit with both companions completes the objective automatically after an action; no separate Extract command is required."
	return "Elimination: defeat every enemy while keeping a hero alive. Losing all heroes is defeat. If one atomic blast eliminates both factions, the result is a draw."
static func tips() -> String:
	return ControlBindings.instructions("\n\nONE ACTION, SEPARATE MOVEMENT\nBasic attacks and abilities share one action per turn. You may move before and after acting, using the same movement budget. No action remaining does not mean no movement remaining. Initiative uses the displayed order, with stable IDs breaking ties.\n\nTARGETING\nMove previews measure the full route around obstacles. Green is movement available now; red is beyond your allowance. Click beyond range to stop at the green STOP ring; nothing is queued for another turn. Unreachable or invalid clicks spend nothing. Attack previews show fixed damage and a shared validation reason. Walls block attacks; living units also block ranged shots. Check range and line of sight before spending your action. Escape cancels targeting.\n\nABILITIES\nMend heals eligible friendly companions, including yourself, but not full-health units. It can revive downed or stabilised companions if there is clear space to stand. Dead companions cannot be revived. Cooldowns block the displayed number of subsequent owner turns and become ready at the following turn start. Slowed halves the next two movement allocations; refreshing it extends duration without stacking.\n\nFIREBURST — OPTIONAL SAFE INSPECTION\nSelect Fireburst, select ground, and inspect the highlighted units and ALLY HIT warning. A second click confirms. Cancel with Escape to inspect safely without damaging anyone. Fireburst can damage allies and its caster.\n\nOBJECTIVES\nHold Ground checks only at round end; an empty or contested zone resets progress. Extraction requires all deployed heroes alive at the exit. Reopen Briefing for this encounter's exact goal.")

static func survival() -> String:
	var rules: RosterRules=load("res://definitions/roster_rules.tres")
	return "Downed companions cannot act or block movement. Bleed-out advances at %d future round ends; the round they fall does not count. Stabilise stops bleeding without healing. Stabilise, Carry, Drop and Extract each cost one shared action. Carry halves movement; Drop does not refund it. Mend may revive a downed/stabilised companion with room to stand, but never a dead companion. Victory recovers conscious, stabilised and safely carried companions; bleeding companions left behind can die. Retreat/abandon preserves only extracted companions. Use the marked retreat zone (or objective exit). Safe extraction is not automatically mission victory. Dead companions are permanently lost."%rules.bleed_rounds

static func campaign(state: CampaignState) -> String:
	var rules := state.rules
	var roster: RosterRules=state.roster_rules
	return "RECRUITS AND SPECIALISATION\nChoose two to your Commander’s Tent deployment capacity in distinct living companions. Recruits unlock permanent specialisation at level 2 (%d XP). Optional basic training costs %d Supplies and brings a recruit to at least %d XP. Surviving participants earn %d XP plus %d for victory. Dead companions earn no XP.\n\nRECOVERY AND REPLACEMENTS\nRecruitment costs %d Supplies. Injuries affect adjusted deployment stats: %d maximum health and %.1f m movement. Existing injuries recover 1 step when deployed, 2 when resting; new injuries do not recover immediately. Injured companions may deploy.\n\nCONSEQUENCES\nVictory awards the displayed offer reward; failure awards %d Supplies. Mission threat changes by %+d on victory or %+d on failure; ignored offers add at most %d per board. Threat %d ends the campaign. Inspect the actual mission roster and objective before deployment.\n\nCAMP DECISIONS AND COMPANIONS\nBackgrounds describe companions; they add no hidden combat bonuses. Open Service Record in the roster, including memorials. A short decision may follow a mission. Exact consequences are shown before confirmation. Decide later returns to camp; resolve or explicitly decline before deploying. Decisions and records save with the campaign and cannot be claimed twice.\n\nEQUIPMENT AND COMMAND\nBuy items at the Camp Outfitter, then open a companion’s character and select a slot to equip owned compatible gear. Weapon/body armour start unlocked; helmets unlock at level 2, accessories at level 3, advanced items at level 4. Commander’s Tent upgrades raise maximum deployment from two to three, then four; smaller parties remain allowed.\n\nVISITING TRADER\nA trader arrives after every two completed campaign missions, including failures, and stays until the next deployment. Stock is fixed across reloads; each premium offer has one owned instance. Purchases go to inventory and still require class/level-compatible equipment slots.\n\nSAVES\nProgress saves between encounters. Closing during a mission restarts that committed mission from its original deployment. Training practice never replaces the campaign save.\n\n%s"%[rules.xp_thresholds[1],roster.training_cost,roster.training_xp,rules.participation_xp,rules.success_xp,roster.recruit_cost,rules.injury_health,rules.injury_movement,rules.failure_supplies,rules.victory_threat,rules.failure_threat,rules.maximum_ignored_threat,rules.threat_maximum,survival()]
